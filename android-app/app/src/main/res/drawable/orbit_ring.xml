<?xml version="1.0" encoding="utf-8"?>
<!-- v6.13: orbit ring for the Dashboard animation. A plain circular ring
     rotated is invisible, so the small dot at the top makes the rotation
     visible — the dot orbits the ring (gol gol ghurteche). Used by an
     ImageView rotated with an ObjectAnimator (0->360, slow, infinite).
     minSdk 24, so item width/height attributes are fine. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="3dp" android:color="#F97316" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="14dp"
        android:height="14dp"
        android:gravity="top|center_horizontal">
        <shape android:shape="oval">
            <solid android:color="#F97316" />
        </shape>
    </item>
</layer-list>
