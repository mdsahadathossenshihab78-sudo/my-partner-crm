<?xml version="1.0" encoding="utf-8"?>
<!-- Design #2: report total row — bg #f06414, 2dp #2e1c10 border, 10dp radius, 3dp HARD shadow (no blur). Text white (XML-e). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/d2_hard" />
        </shape>
    </item>
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/d2_accent" />
            <stroke android:width="2dp" android:color="@color/d2_line" />
        </shape>
    </item>
</layer-list>
