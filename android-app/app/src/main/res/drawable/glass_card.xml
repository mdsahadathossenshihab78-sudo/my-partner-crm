<?xml version="1.0" encoding="utf-8"?>
<!-- Design #2: card — bg #fffaf0, 2dp #2e1c10 border, 12dp radius, 5dp HARD shadow (no blur).
     Android-e CSS box-shadow nei — shadow = solid #2e1c10 layer 5dp niche-dane, card tar upore 5dp inset. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="5dp" android:top="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/d2_hard" />
        </shape>
    </item>
    <item android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/d2_surface" />
            <stroke android:width="2dp" android:color="@color/d2_line" />
        </shape>
    </item>
</layer-list>
