<?xml version="1.0" encoding="utf-8"?>
<!-- v6.13: "পরের:" strip header item inside the call-list RecyclerView.
     Holds a horizontal RecyclerView (NextStripAdapter, item_next_number).
     The strip itself is the second header item (after the focus card). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView android:id="@+id/stripHeaderLabel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="পরের:" android:textSize="13sp" android:textStyle="bold"
        android:textColor="@color/muted_warm"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:layout_marginTop="10dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/stripInner"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="6dp" android:clipToPadding="false" />
</LinearLayout>
