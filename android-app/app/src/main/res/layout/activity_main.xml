<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_aurora">
    <!-- Login view -->
    <LinearLayout android:id="@+id/loginView"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="28dp">
        <TextView android:layout_width="92dp" android:layout_height="92dp"
            android:layout_gravity="center" android:background="@drawable/logo_gradient"
            android:gravity="center" android:text="T" android:textSize="40sp"
            android:textStyle="bold" android:textColor="@color/white" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:layout_marginTop="18dp"
            android:text="@string/login_title" android:textSize="26sp" android:textStyle="bold"
            android:textColor="@color/white" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:layout_marginTop="8dp"
            android:text="কল লিস্ট • স্ট্যাটাস • এক জায়গায়" android:textSize="13sp"
            android:textColor="@color/lavender" />
        <com.google.android.material.button.MaterialButton android:id="@+id/googleBtn"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="30dp" android:text="@string/continue_google"
            android:textSize="15sp" android:textStyle="bold" android:textColor="@color/white"
            app:backgroundTint="@null" android:background="@drawable/btn_gradient" />
        <TextView android:id="@+id/loginError" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:textColor="@color/error_light" android:textSize="13sp" />
    </LinearLayout>
    <!-- Agent ID view -->
    <LinearLayout android:id="@+id/agentView"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="28dp"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Agent ID din" android:textSize="26sp" android:textStyle="bold"
            android:textColor="@color/white" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:layout_marginTop="8dp"
            android:text="Je list dekhte chan, sei Agent ID likhun" android:textSize="13sp"
            android:textColor="@color/lavender" />
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/agentInput"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="30dp" android:hint="Agent ID"
            android:background="@drawable/glass_field" android:padding="12dp"
            android:textColor="@color/white" android:textColorHint="@color/muted_light" />
        <com.google.android.material.button.MaterialButton android:id="@+id/agentContinueBtn"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="14dp" android:text="Continue"
            android:textSize="15sp" android:textStyle="bold" android:textColor="@color/white"
            app:backgroundTint="@null" android:background="@drawable/btn_gradient" />
        <com.google.android.material.button.MaterialButton android:id="@+id/agentBackBtn"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="10dp" android:text="Onno Gmail diye login"
            app:backgroundTint="@null" android:background="@drawable/glass_field"
            android:textColor="@color/white" />
        <TextView android:id="@+id/agentError" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:textColor="@color/error_light" android:textSize="13sp" />
    </LinearLayout>
    <!-- Main view: dashboard (top bar + Report + stats) scrolls away on scroll;
         tabs + search stay pinned, list gets full height -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout android:id="@+id/mainView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:focusable="true" android:focusableInTouchMode="true"
        android:visibility="gone">
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@android:color/transparent" app:elevation="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll|snap">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
            <TextView android:layout_width="38dp" android:layout_height="38dp"
                android:background="@drawable/logo_gradient" android:gravity="center"
                android:text="T" android:textSize="23sp" android:textStyle="bold"
                android:textColor="@color/white" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Telesales Status" android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/white" />
                <TextView android:id="@+id/agentSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="আজকের কল লিস্ট" android:textSize="12sp"
                    android:textColor="@color/lavender" />
            </LinearLayout>
            <TextView android:id="@+id/avatarView" android:layout_width="36dp" android:layout_height="36dp"
                android:background="@drawable/avatar_gradient" android:gravity="center"
                android:text="S" android:textSize="14sp" android:textStyle="bold"
                android:textColor="@color/white" />
        </LinearLayout>
        </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.core.widget.NestedScrollView android:id="@+id/dashboardView" android:clipToPadding="false" android:paddingBottom="24dp"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:layout_marginBottom="88dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <!-- v4.13 dashboard redesign: hero totals at the top -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingTop="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/stat_violet" android:padding="16dp" android:layout_marginEnd="6dp">
                <TextView android:id="@+id/statTotalCallDay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="মোট কল" android:textSize="12sp" android:textColor="#E6FFFFFF" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/stat_green" android:padding="16dp" android:layout_marginStart="6dp">
                <TextView android:id="@+id/statTotalNumDay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="মোট নাম্বার" android:textSize="12sp" android:textColor="#E6FFFFFF" />
            </LinearLayout>
        </LinearLayout>
        <!-- v4.13: date selector as a centered glass pill -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingTop="12dp" android:gravity="center">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/glass_card" android:padding="6dp" android:gravity="center_vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPrevDay" android:layout_width="48dp" android:layout_height="48dp" android:text="◀" app:backgroundTint="@null" android:background="@drawable/glass_field" android:textColor="@color/white" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDate" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:text="তারিখ" android:textSize="15sp" android:textStyle="bold" app:backgroundTint="@null" android:background="@drawable/glass_field" android:textColor="@color/white" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnNextDay" android:layout_width="48dp" android:layout_height="48dp" android:text="▶" app:backgroundTint="@null" android:background="@drawable/glass_field" android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>
        <!-- v4.13: day tiles, color-coded by meaning, 2-column grid -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingTop="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/stat_green" android:padding="14dp" android:layout_marginEnd="6dp">
                <TextView android:id="@+id/statConnDay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connected" android:textSize="10sp" android:textColor="#E6FFFFFF" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/stat_rose" android:padding="14dp" android:layout_marginStart="6dp">
                <TextView android:id="@+id/statNotConnDay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Not Connected" android:textSize="10sp" android:textColor="#E6FFFFFF" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingTop="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/stat_blue" android:padding="14dp" android:layout_marginEnd="6dp">
                <TextView android:id="@+id/statValidDay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Valid" android:textSize="10sp" android:textColor="#E6FFFFFF" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/stat_rose" android:padding="14dp" android:layout_marginStart="6dp">
                <TextView android:id="@+id/statInvDay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Invalid" android:textSize="10sp" android:textColor="#E6FFFFFF" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingTop="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/stat_violet" android:padding="14dp" android:layout_marginEnd="6dp">
                <TextView android:id="@+id/statFtdDay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FTD" android:textSize="10sp" android:textColor="#E6FFFFFF" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/stat_rose" android:padding="14dp" android:layout_marginStart="6dp">
                <TextView android:id="@+id/statFtdAmtDay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="৳0" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FTD টাকা" android:textSize="10sp" android:textColor="#E6FFFFFF" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingTop="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/stat_violet" android:padding="14dp">
                <TextView android:id="@+id/statRegDay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/white" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Registration" android:textSize="10sp" android:textColor="#E6FFFFFF" />
            </LinearLayout>
        </LinearLayout>
        <!-- v4.13: 7-day summary as a separate glass card/strip -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card" android:padding="14dp">
                <TextView android:id="@+id/weekSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout></androidx.core.widget.NestedScrollView> <LinearLayout android:id="@+id/listContent"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:layout_marginBottom="0dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingTop="14dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTabPending"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:text="কল বাকি" app:backgroundTint="@null"
                android:background="@drawable/btn_gradient" android:textColor="@color/white" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTabDone"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:layout_marginStart="10dp" android:text="কল করা হয়েছে"
                app:backgroundTint="@null" android:background="@drawable/glass_field"
                android:textColor="@color/white" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingTop="14dp">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/searchBox"
                android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1"
                android:hint="Number diye khujun" android:inputType="text"
                android:background="@drawable/glass_field" android:padding="12dp"
                android:textColor="@color/white" android:textColorHint="@color/muted_light" />
            <com.google.android.material.button.MaterialButton android:id="@+id/refreshBtn"
                android:layout_width="wrap_content" android:layout_height="56dp"
                android:layout_marginStart="8dp" android:text="Refresh"
                app:backgroundTint="@null" android:background="@drawable/glass_field"
                android:textColor="@color/white" />
        </LinearLayout>
        <TextView android:id="@+id/statusText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="14dp"
            android:textSize="13sp" android:textColor="@color/muted_light" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:paddingTop="8dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="96dp" android:clipToPadding="false" />
        </LinearLayout>
                </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <!-- Report view -->
    <ScrollView android:id="@+id/reportView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Report" android:textSize="20sp"
                    android:textStyle="bold" android:textColor="@color/white"
                    android:paddingStart="12dp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="সারাদিন এন্ট্রি যোগ করুন, রাতে Generate করে কপি করুন"
                android:textSize="13sp" android:textColor="@color/lavender" android:layout_marginTop="6dp" />
            <TextView android:id="@+id/reportStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="13sp"
                android:textColor="@color/muted_light" android:layout_marginTop="8dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/glass_card"
                android:padding="16dp" android:layout_marginTop="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="REGISTRATION" android:textSize="12sp" android:textStyle="bold"
                    android:textColor="@color/white" />
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/regCount"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:hint="Registration সংখ্যা" android:inputType="number"
                    android:background="@drawable/glass_field" android:padding="12dp"
                    android:layout_marginTop="10dp" android:textColor="@color/white"
                    android:textColorHint="@color/muted_light" />
                <com.google.android.material.button.MaterialButton android:id="@+id/regAddBtn"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="10dp" android:text="Add"
                    app:backgroundTint="@null" android:background="@drawable/btn_gradient"
                    android:textColor="@color/white" />
                <LinearLayout android:id="@+id/regList" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/glass_card"
                android:padding="16dp" android:layout_marginTop="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="FTD" android:textSize="12sp" android:textStyle="bold"
                    android:textColor="@color/white" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/ftdMinusBtn"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:text="-" android:textSize="20sp"
                        app:backgroundTint="@null" android:background="@drawable/glass_field"
                        android:textColor="@color/white" />
                    <TextView android:id="@+id/ftdStepCount"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="0" android:textSize="24sp" android:textStyle="bold"
                        android:gravity="center" android:textColor="@color/white" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/ftdPlusBtn"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:text="+" android:textSize="20sp"
                        app:backgroundTint="@null" android:background="@drawable/btn_gradient"
                        android:textColor="@color/white" />
                </LinearLayout>
                <LinearLayout android:id="@+id/ftdStepAmountRow" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:visibility="gone">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/ftdStepAmount"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:hint="এই FTD কত টাকার?" android:inputType="numberDecimal"
                        android:background="@drawable/glass_field" android:padding="12dp"
                        android:layout_marginTop="10dp" android:textColor="@color/white"
                        android:textColorHint="@color/muted_light" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/ftdStepAddBtn"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:layout_marginTop="10dp" android:text="টাকা যোগ করুন"
                        app:backgroundTint="@null" android:background="@drawable/btn_gradient"
                        android:textColor="@color/white" />
                </LinearLayout>
                <TextView android:id="@+id/ftdTotal" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/white" android:layout_marginTop="6dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/glass_card"
                android:padding="16dp" android:layout_marginTop="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="INVALID NUMBER" android:textSize="12sp" android:textStyle="bold"
                    android:textColor="@color/white" />
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/invNumber"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:hint="নাম্বার" android:inputType="phone"
                    android:background="@drawable/glass_field" android:padding="12dp"
                    android:layout_marginTop="10dp" android:textColor="@color/white"
                    android:textColorHint="@color/muted_light" />
                <Spinner android:id="@+id/invReason" android:layout_width="match_parent"
                    android:layout_height="52dp" android:background="@drawable/glass_field"
                    android:layout_marginTop="10dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/invAddBtn"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="10dp" android:text="Add"
                    app:backgroundTint="@null" android:background="@drawable/btn_gradient"
                    android:textColor="@color/white" />
                <LinearLayout android:id="@+id/invList" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/glass_card"
                android:padding="16dp" android:layout_marginTop="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PROBLEMS" android:textSize="12sp" android:textStyle="bold"
                    android:textColor="@color/white" />
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/probText"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:hint="সমস্যাটা লিখুন"
                    android:background="@drawable/glass_field" android:padding="12dp"
                    android:layout_marginTop="10dp" android:textColor="@color/white"
                    android:textColorHint="@color/muted_light" />
                <com.google.android.material.button.MaterialButton android:id="@+id/probAddBtn"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="10dp" android:text="Add"
                    app:backgroundTint="@null" android:background="@drawable/btn_gradient"
                    android:textColor="@color/white" />
                <LinearLayout android:id="@+id/probList" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/generateBtn"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="16dp" android:text="Generate Report"
                app:backgroundTint="@null" android:background="@drawable/btn_gradient"
                android:textColor="@color/white" android:textStyle="bold" />
            <LinearLayout android:id="@+id/reportOutputCard" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:background="@drawable/glass_card" android:padding="16dp"
                android:layout_marginTop="12dp" android:visibility="gone">
                <TextView android:id="@+id/reportOutput" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="14sp"
                    android:textColor="@color/white" android:textIsSelectable="true" />
                <com.google.android.material.button.MaterialButton android:id="@+id/copyBtn"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="12dp" android:text="Copy korun"
                    app:backgroundTint="@null" android:background="@drawable/btn_gradient"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <!-- Guide view: Bangla user manual -->
    <ScrollView android:id="@+id/guideView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="28dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="ইউজার গাইড" android:textSize="26sp" android:textStyle="bold"
                android:textColor="@color/white" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:layout_marginTop="8dp"
                android:text="অ্যাপ ব্যবহারের নিয়ম" android:textSize="13sp"
                android:textColor="@color/lavender" />
            <TextView android:id="@+id/guideText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:textSize="15sp" android:lineSpacingMultiplier="1.25"
                android:textColor="@color/white" />
        </LinearLayout>
    </ScrollView>
    <!-- Admin view: number paste kore Agent-er list-e jog kora -->
    <ScrollView android:id="@+id/adminView"
        android:layout_width="match_parent" android:layout_height="match_parent"
