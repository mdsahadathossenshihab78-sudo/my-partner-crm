<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center" android:padding="28dp"
    android:background="@drawable/glass_card">
    <ImageView android:id="@+id/loadingLogo" android:layout_width="72dp" android:layout_height="72dp"
        android:layout_gravity="center" android:src="@drawable/ic_logo_t"
        android:contentDescription="Telesales Agent CRM" />
    <ProgressBar android:id="@+id/loadingBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="180dp" android:layout_height="6dp"
        android:layout_marginTop="18dp" android:indeterminate="true"
        android:indeterminateTint="@color/orange" />
    <TextView android:id="@+id/loadingText" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:layout_marginTop="14dp"
        android:text="লোড হচ্ছে..." android:textSize="14sp" android:textStyle="bold"
        android:textColor="@color/ink" />
</LinearLayout>
