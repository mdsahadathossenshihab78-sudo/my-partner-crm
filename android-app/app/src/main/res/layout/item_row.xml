<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/glass_card"
    android:layout_margin="6dp" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tvNumber" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="19sp" android:textStyle="bold"
            android:textColor="@color/white" />
        <TextView android:id="@+id/tvRow" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/lavender" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp">
        <TextView android:id="@+id/tvChipStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:background="@drawable/chip_grey"
            android:paddingHorizontal="11dp" android:paddingVertical="4dp"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/white" />
        <TextView android:id="@+id/tvChipValid" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:background="@drawable/chip_blue"
            android:paddingHorizontal="11dp" android:paddingVertical="4dp"
            android:layout_marginStart="8dp" android:textSize="12sp" android:textStyle="bold"
            android:textColor="@color/white" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/tvHistory" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/muted_light"
        android:layout_marginTop="8dp" android:visibility="gone" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="কলিং স্ট্যাটাস" android:textSize="11sp" android:textStyle="bold"
        android:textColor="@color/muted_light" android:letterSpacing="0.05" android:layout_marginTop="12dp" />
    <Spinner android:id="@+id/spStatus" android:layout_width="match_parent" android:layout_height="52dp"
        android:background="@drawable/glass_field" android:layout_marginTop="6dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="ভ্যালিড কনভারসেশন" android:textSize="11sp" android:textStyle="bold"
        android:textColor="@color/muted_light" android:letterSpacing="0.05" android:layout_marginTop="10dp" />
    <Spinner android:id="@+id/spValid" android:layout_width="match_parent" android:layout_height="52dp"
        android:background="@drawable/glass_field" android:layout_marginTop="6dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="১ম কল রিমার্ক" android:textSize="11sp" android:textStyle="bold"
        android:textColor="@color/muted_light" android:letterSpacing="0.05" android:layout_marginTop="10dp" />
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etRemark1"
        android:layout_width="match_parent" android:layout_height="52dp" android:hint="১ম কলের রিমার্ক"
        android:background="@drawable/glass_field" android:padding="12dp" android:layout_marginTop="6dp"
        android:textColor="@color/white" android:textColorHint="@color/muted_light" />
    <!-- v4.36: ১ম রিমার্ক কপি বাটন (লং-প্রেসে কপি হয় না বলে) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="end" android:layout_marginTop="6dp">
        <android.widget.Button android:id="@+id/copyRemark1Btn" android:layout_width="wrap_content"
            android:layout_height="40dp" android:paddingHorizontal="16dp" android:text="কপি"
            android:textSize="12sp" android:background="@drawable/glass_field" android:textColor="@color/white" />
    </LinearLayout>
    <!-- Batch feature #6: remark quick phrase — ek tap-e 1st remark-e bosbe -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <android.widget.Button android:id="@+id/phraseBtn1" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:text="বিকেলে করবে"
            android:textSize="12sp" android:background="@drawable/glass_field" android:textColor="@color/white" />
        <android.widget.Button android:id="@+id/phraseBtn2" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp"
            android:text="ফোন বন্ধ" android:textSize="12sp"
            android:background="@drawable/glass_field" android:textColor="@color/white" />
        <android.widget.Button android:id="@+id/phraseBtn3" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp"
            android:text="পরে কল করতে বলেছে" android:textSize="12sp"
            android:background="@drawable/glass_field" android:textColor="@color/white" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="২য় কল রিমার্ক" android:textSize="11sp" android:textStyle="bold"
        android:textColor="@color/muted_light" android:letterSpacing="0.05" android:layout_marginTop="10dp" />
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etRemark2"
        android:layout_width="match_parent" android:layout_height="52dp" android:hint="২য় কলের রিমার্ক"
        android:background="@drawable/glass_field" android:padding="12dp" android:layout_marginTop="6dp"
        android:textColor="@color/white" android:textColorHint="@color/muted_light" />
    <!-- v4.36: ২য় রিমার্ক কপি বাটন -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="end" android:layout_marginTop="6dp">
        <android.widget.Button android:id="@+id/copyRemark2Btn" android:layout_width="wrap_content"
            android:layout_height="40dp" android:paddingHorizontal="16dp" android:text="কপি"
            android:textSize="12sp" android:background="@drawable/glass_field" android:textColor="@color/white" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="অন্যান্য নাম্বার" android:textSize="11sp" android:textStyle="bold"
        android:textColor="@color/muted_light" android:letterSpacing="0.05" android:layout_marginTop="10dp" />
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etOthers"
        android:layout_width="match_parent" android:layout_height="52dp" android:hint="অন্যান্য নাম্বার"
        android:inputType="phone" android:background="@drawable/glass_field" android:padding="12dp"
        android:layout_marginTop="6dp" android:textColor="@color/white" android:textColorHint="@color/muted_light" />
    <!-- v4.36: অন্যান্য নাম্বার কপি বাটন -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="end" android:layout_marginTop="6dp">
        <android.widget.Button android:id="@+id/copyOthersBtn" android:layout_width="wrap_content"
            android:layout_height="40dp" android:paddingHorizontal="16dp" android:text="কপি"
            android:textSize="12sp" android:background="@drawable/glass_field" android:textColor="@color/white" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="14dp">
        <android.widget.Button android:id="@+id/btnCall" android:layout_width="0dp"
            android:layout_height="52dp" android:layout_weight="1" android:text="কল"
            android:background="@drawable/glass_field" android:textColor="@color/white" />
        <android.widget.Button android:id="@+id/btnCopy" android:layout_width="0dp"
            android:layout_height="52dp" android:layout_weight="1"
            android:layout_marginStart="10dp" android:text="কপি"
            android:background="@drawable/glass_field" android:textColor="@color/white" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSave"
            android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1.4"
            android:layout_marginStart="10dp" android:text="সেভ করুন"
            app:backgroundTint="@null" android:background="@drawable/btn_gradient"
            android:textColor="@color/white" />
    </LinearLayout>
    <!-- v4.31: call reminder — choto affordance, Call/Copy/Save-er motoi row-e -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp">
        <android.widget.Button android:id="@+id/remindBtn" android:layout_width="match_parent"
            android:layout_height="48dp" android:text="মনে করিয়ে দিন"
            android:background="@drawable/glass_field" android:textColor="@color/white" />
    </LinearLayout>
</LinearLayout>
