<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/glass_card"
    android:layout_margin="6dp" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tvNumber" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="17sp" android:textStyle="bold"
            android:textColor="@color/white" />
        <TextView android:id="@+id/tvRow" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/lavender" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="6dp">
        <TextView android:id="@+id/tvChipStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:background="@drawable/chip_grey"
            android:paddingHorizontal="11dp" android:paddingVertical="3dp"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/white" />
        <TextView android:id="@+id/tvChipValid" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:background="@drawable/chip_blue"
            android:paddingHorizontal="11dp" android:paddingVertical="3dp"
            android:layout_marginStart="8dp" android:textSize="12sp" android:textStyle="bold"
            android:textColor="@color/white" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/tvHistory" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/muted_light"
        android:layout_marginTop="4dp" android:visibility="gone" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="কলিং স্ট্যাটাস" android:textSize="11sp" android:textStyle="bold"
        android:textColor="@color/muted_light" android:letterSpacing="0.05" android:layout_marginTop="6dp" />
    <TextView android:id="@+id/tvStatusField" android:layout_width="match_parent" android:layout_height="44dp"
        android:background="@drawable/glass_field" android:layout_marginTop="4dp" android:paddingHorizontal="10dp"
        android:gravity="center_vertical" android:textSize="14sp" android:textColor="@color/white"
        android:clickable="true" android:focusable="true" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="ভ্যালিড কনভারসেশন" android:textSize="11sp" android:textStyle="bold"
        android:textColor="@color/muted_light" android:letterSpacing="0.05" android:layout_marginTop="6dp" />
    <TextView android:id="@+id/tvValidField" android:layout_width="match_parent" android:layout_height="44dp"
        android:background="@drawable/glass_field" android:layout_marginTop="4dp" android:paddingHorizontal="10dp"
        android:gravity="center_vertical" android:textSize="14sp" android:textColor="@color/white"
        android:clickable="true" android:focusable="true" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="১ম কলের মন্তব্য" android:textSize="11sp" android:textStyle="bold"
        android:textColor="@color/muted_light" android:letterSpacing="0.05" android:layout_marginTop="6dp" />
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etRemark1"
        android:layout_width="match_parent" android:layout_height="44dp" android:hint="১ম কলের মন্তব্য"
        android:background="@drawable/glass_field" android:padding="10dp" android:layout_marginTop="4dp"
        android:textColor="@color/white" android:textColorHint="@color/muted_light" />
    <!-- Batch feature #6: remark quick phrase — ek tap-e 1st remark-e bosbe -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <android.widget.Button android:id="@+id/phraseBtn1" android:layout_width="0dp"
            android:layout_height="40dp" android:layout_weight="1" android:text="বিকেলে করবে"
            android:textSize="12sp" android:background="@drawable/glass_field" android:textColor="@color/white" />
        <android.widget.Button android:id="@+id/phraseBtn2" android:layout_width="0dp"
            android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="8dp"
            android:text="ফোন বন্ধ" android:textSize="12sp"
            android:background="@drawable/glass_field" android:textColor="@color/white" />
        <android.widget.Button android:id="@+id/phraseBtn3" android:layout_width="0dp"
            android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="8dp"
            android:text="পরে কল করতে বলেছে" android:textSize="12sp"
            android:background="@drawable/glass_field" android:textColor="@color/white" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="২য় কলের মন্তব্য" android:textSize="11sp" android:textStyle="bold"
        android:textColor="@color/muted_light" android:letterSpacing="0.05" android:layout_marginTop="6dp" />
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etRemark2"
        android:layout_width="match_parent" android:layout_height="44dp" android:hint="২য় কলের মন্তব্য"
        android:background="@drawable/glass_field" android:padding="10dp" android:layout_marginTop="4dp"
        android:textColor="@color/white" android:textColorHint="@color/muted_light" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="অন্য নাম্বার" android:textSize="11sp" android:textStyle="bold"
        android:textColor="@color/muted_light" android:letterSpacing="0.05" android:layout_marginTop="6dp" />
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etOthers"
        android:layout_width="match_parent" android:layout_height="44dp" android:hint="অন্য নাম্বার"
        android:inputType="phone" android:background="@drawable/glass_field" android:padding="10dp"
        android:layout_marginTop="4dp" android:textColor="@color/white" android:textColorHint="@color/muted_light" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCall" android:layout_width="0dp"
            android:layout_height="44dp" android:layout_weight="1" android:text="কল" android:minWidth="0dp"
            app:icon="@drawable/ic_call" app:iconSize="20dp" app:iconPadding="8dp"
            app:backgroundTint="@null" android:background="@drawable/glass_field" android:textColor="@color/white" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCopy" android:layout_width="0dp"
            android:layout_height="44dp" android:layout_weight="1" android:minWidth="0dp"
            android:layout_marginStart="10dp" android:text="কপি"
            app:icon="@drawable/ic_copy" app:iconSize="20dp" app:iconPadding="8dp"
            app:backgroundTint="@null" android:background="@drawable/glass_field" android:textColor="@color/white" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSave"
            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1.4"
            android:layout_marginStart="10dp" android:text="সেভ করুন"
            app:icon="@drawable/ic_save" app:iconSize="20dp" app:iconPadding="8dp"
            app:backgroundTint="@null" android:background="@drawable/btn_gradient"
            android:textColor="@color/white" />
    </LinearLayout>
    <!-- v4.31: call reminder — choto affordance, Call/Copy/Save-er motoi row-e -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="6dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/remindBtn" android:layout_width="match_parent"
            android:layout_height="40dp" android:text="মনে করিয়ে দিন" android:minWidth="0dp"
            app:icon="@drawable/ic_bell" app:iconSize="20dp" app:iconPadding="8dp"
            app:backgroundTint="@null" android:background="@drawable/glass_field" android:textColor="@color/white" />
    </LinearLayout>
</LinearLayout>
