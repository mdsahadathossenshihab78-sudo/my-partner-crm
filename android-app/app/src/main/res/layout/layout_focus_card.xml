<?xml version="1.0" encoding="utf-8"?>
<!-- v6.9 (Phase 1): Design 3 Energy Sales FOCUS CARD — board spec:
     "একবারে একটা নাম্বারে ফোকাস — বড় নাম্বার, বড় Call বাটন, পরের নাম্বারগুলো নিচে লাইনে"
     Board C-panel order: header → big number → big Call → Copy → chips → remarks → Save →
     next numbers strip (separate view, item_next_number.xml).
     NOTE: all ids are focus*-prefixed on purpose — item_row.xml uses the same field
     names (tvNumber, btnCall, ...) inside the RecyclerView, and activity-level
     findViewById would be ambiguous if the focus card reused them. Phase 2 binds
     these ids explicitly via the included view (focusCard.findViewById(...)).
     Reuses existing Energy Sales drawables/colors only — no new drawable needed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/glass_card"
    android:layout_margin="6dp" android:padding="16dp">
    <TextView android:id="@+id/focusHeaderTitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="কল করুন — একটা করে" android:textSize="16sp" android:textStyle="bold"
        android:textColor="@color/ink" />
    <TextView android:id="@+id/focusHeaderSub"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="— নম্বর নাম্বার · বাকি আছে —টা" android:textSize="13sp"
        android:textColor="@color/muted_warm" android:layout_marginTop="2dp" />
    <TextView android:id="@+id/focusTvNumber"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="34sp" android:textStyle="bold" android:textColor="@color/ink"
        android:layout_marginTop="12dp" />
    <TextView android:id="@+id/focusTvRow"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/muted_warm" android:layout_marginTop="2dp" />
    <TextView android:id="@+id/focusTvHistory"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/muted_warm"
        android:layout_marginTop="4dp" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/focusBtnCall"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="14dp" android:text="কল করুন" android:textSize="17sp"
        android:textStyle="bold" android:minWidth="0dp" android:minHeight="0dp"
        android:gravity="center" app:icon="@drawable/ic_call" app:iconSize="24dp"
        app:iconPadding="10dp" app:iconGravity="textStart"
        app:backgroundTint="@null" android:background="@drawable/btn_gradient"
        android:textColor="@color/white" />
    <com.google.android.material.button.MaterialButton android:id="@+id/focusBtnCopy"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="10dp" android:text="📋 কপি করুন" android:textSize="14sp"
        android:minWidth="0dp" android:minHeight="0dp" android:gravity="center"
        app:backgroundTint="@null" android:background="@drawable/glass_field"
        android:textColor="@color/ink" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="কলিং স্ট্যাটাস" android:textSize="12sp" android:textStyle="bold"
        android:textColor="@color/muted_warm" android:letterSpacing="0.05" android:layout_marginTop="12dp" />
    <!-- v4.44: ek tap-e chip — kono popup na (row-er motoi) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <TextView android:id="@+id/focusStatusChipConn" android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:background="@drawable/glass_field" android:gravity="center"
            android:text="Connected" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/ink" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/focusStatusChipNotConn" android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/glass_field"
            android:gravity="center" android:text="Not Connected" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/ink" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="ভ্যালিড কনভারসেশন" android:textSize="12sp" android:textStyle="bold"
        android:textColor="@color/muted_warm" android:letterSpacing="0.05" android:layout_marginTop="10dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <TextView android:id="@+id/focusValidChipYes" android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:background="@drawable/glass_field" android:gravity="center"
            android:text="Yes" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/ink" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/focusValidChipNo" android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/glass_field"
            android:gravity="center" android:text="No" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/ink" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="১ম কলের মন্তব্য" android:textSize="12sp" android:textStyle="bold"
        android:textColor="@color/muted_warm" android:letterSpacing="0.05" android:layout_marginTop="10dp" />
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/focusEtRemark1"
        android:layout_width="match_parent" android:layout_height="44dp" android:hint="১ম কলের মন্তব্য"
        android:background="@drawable/glass_field" android:padding="10dp" android:layout_marginTop="4dp"
        android:textColor="@color/ink" android:textColorHint="@color/muted_warm" />
    <!-- Batch feature #6: remark quick phrase — ek tap-e 1st remark-e bosbe (row-er motoi) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp">
        <android.widget.Button android:id="@+id/focusPhraseBtn1" android:layout_width="0dp"
            android:layout_height="40dp" android:minHeight="0dp" android:minWidth="0dp" android:layout_weight="1" android:text="বিকেলে করবে"
            android:textSize="12sp" android:background="@drawable/glass_field" android:textColor="@color/ink" />
        <android.widget.Button android:id="@+id/focusPhraseBtn2" android:layout_width="0dp"
            android:layout_height="40dp" android:minHeight="0dp" android:minWidth="0dp" android:layout_weight="1" android:layout_marginStart="8dp"
            android:text="ফোন বন্ধ" android:textSize="12sp"
            android:background="@drawable/glass_field" android:textColor="@color/ink" />
        <android.widget.Button android:id="@+id/focusPhraseBtn3" android:layout_width="0dp"
            android:layout_height="40dp" android:minHeight="0dp" android:minWidth="0dp" android:layout_weight="1" android:layout_marginStart="8dp"
            android:text="পরে কল করতে বলেছে" android:textSize="12sp"
            android:background="@drawable/glass_field" android:textColor="@color/ink" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="২য় কলের মন্তব্য" android:textSize="12sp" android:textStyle="bold"
        android:textColor="@color/muted_warm" android:letterSpacing="0.05" android:layout_marginTop="10dp" />
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/focusEtRemark2"
        android:layout_width="match_parent" android:layout_height="44dp" android:hint="২য় কলের মন্তব্য"
        android:background="@drawable/glass_field" android:padding="10dp" android:layout_marginTop="4dp"
        android:textColor="@color/ink" android:textColorHint="@color/muted_warm" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="অন্য নাম্বার" android:textSize="12sp" android:textStyle="bold"
        android:textColor="@color/muted_warm" android:letterSpacing="0.05" android:layout_marginTop="10dp" />
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/focusEtOthers"
        android:layout_width="match_parent" android:layout_height="44dp" android:hint="অন্য নাম্বার"
        android:inputType="phone" android:background="@drawable/glass_field" android:padding="10dp"
        android:layout_marginTop="4dp" android:textColor="@color/ink" android:textColorHint="@color/muted_warm" />
    <com.google.android.material.button.MaterialButton android:id="@+id/focusBtnSave"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="14dp" android:text="সেভ করুন" android:textSize="15sp"
        android:minWidth="0dp" android:minHeight="0dp" android:gravity="center"
        app:icon="@drawable/ic_save" app:iconSize="20dp" app:iconPadding="8dp" app:iconGravity="textStart"
        app:backgroundTint="@null" android:background="@drawable/btn_gradient"
        android:textColor="@color/white" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/focusBtnRemind"
            android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:text="⏰ মনে করিয়ে দিন" android:textSize="13sp"
            android:minWidth="0dp" android:minHeight="0dp" android:gravity="center"
            app:icon="@drawable/ic_bell" app:iconSize="20dp" app:iconPadding="8dp" app:iconGravity="textStart"
            app:backgroundTint="@null" android:background="@drawable/glass_field"
            android:textColor="@color/ink" />
        <com.google.android.material.button.MaterialButton android:id="@+id/focusBtnProblem"
            android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:layout_marginStart="8dp" android:text="⚠️ সমস্যা নাম্বার" android:textSize="13sp"
            android:minWidth="0dp" android:minHeight="0dp" android:gravity="center"
            app:backgroundTint="@null" android:background="@drawable/glass_field"
            android:textColor="@color/ink" />
    </LinearLayout>
</LinearLayout>
